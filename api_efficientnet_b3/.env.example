# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- SSH tunnel to the Postgres host (tenant products DB) ---
# Set to false when the app runs inside the same Azure network as the DB
# (e.g. a VM/VNet with direct connectivity) — then DB_HOST is the real
# Postgres host, not 127.0.0.1, and the SSH_* vars below are unused.
USE_SSH_TUNNEL=true
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PKEY_PATH=/path/to/key.pem

# --- Postgres ---
# USE_SSH_TUNNEL=true:  leave DB_HOST=127.0.0.1 (reached via the tunnel)
# USE_SSH_TUNNEL=false: set DB_HOST to the real Postgres host
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Azure Blob Storage (pending /api/detect-product images) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=pending-detections

# --- Azure Blob Storage (tenant product/category photos) ---
# One shared container (AZURE_TENANT_IMAGES_CONTAINER); blobs are prefixed
# per tenant as "wecomm<tenant_id>/<path>". Relative paths stored in the
# tenant DB (categories.image, product_images.url) are resolved into
# temporary read-only SAS URLs against this account. Leave the connection
# string unset to keep falling back to the ui-avatars placeholder / a raw
# null image_url.
AZURE_TENANT_IMAGES_CONNECTION_STRING=
AZURE_TENANT_IMAGES_CONTAINER=wecommpos

# --- GCS feedback storage (confirm/correct/new-produce) ---
# Uses Application Default Credentials, not a key in this file.
# Run `gcloud auth application-default login` locally, or leave unset to
# use the default bucket.
FEEDBACK_BUCKET=vegdetect-pos-models

# --- App ---
PORT=8080
